    "[['goal', 19], [1, 2, 4, 8, 10], [3, 6, 'X', 18, 14], [5, 'X', 15, 'X', 17], [9, 11, 13, 16, 0]]",
    "```python\ngrid = [[0, 2, 4, 8, 10],\n        [1, 'X', 7, 'X', 12],\n        [3, 6, 'X', 18, 14],\n        [5, 'X', 15, 'X', 17],\n        [9, 11, 13, 16, 19]]\n\nstart = 0\ngoal = 19\n\n# Define possible movements (up, down, left, right)\nmovements = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n\ndef is_valid(x, y):\n    return 0 <= x < len(grid) and 0 <= y < len(grid[0]) and grid[x][y] != 'X'\n\ndef heuristic(node):\n    return abs(node[0] - goal) + abs(node[1] - goal)\n\ndef astar(grid, start, goal):\n    # Create a priority queue to hold nodes\n    open_list = [(heuristic(start), start)]\n    \n    # Create a dictionary to hold the path and cost of each node\n    came_from = {start: None}\n    g_score = {start: 0}\n    \n    while open_list:\n        _, current_node = min(open_list)\n        \n        if current_node == goal:\n            break\n        \n        open_list.remove((heuristic(current_node), current_node))\n        \n        for movement in movements:\n            new_x, new_y = current_node[0] + movement[0], current_node[1] + movement[1]\n            \n            if is_valid(new_x, new_y):\n                new_cost = g_score[current_node] + 1\n                \n                if (new_x, new_y) not in g_score or new_cost < g_score[(new_x, new_y)]:\n                    came_from[(new_x, new_y)] = current_node\n                    g_score[(new_x, new_y)] = new_cost\n                    \n                    # If the new node is better than nodes already in the open list, add it\n                    if (heuristic((new_x, new_y)), (new_x, new_y)) not in open_list:\n                        open_list.append((g_score[(new_x, new_y)] + heuristic((new_x, new_y)), (new_x, new_y)))\n    \n    # If we haven't found the goal yet, there is no path\n    if goal not in g_score:\n        return None\n    \n    # Reconstruct the path\n    current = goal\n    path = []\n    while current is not None:\n        path.append(current)\n        current = came_from[current]\n    \n    return list(reversed(path))\n\npath = astar(grid, (0, 0), (4, 4))\nprint(path)\n```",
