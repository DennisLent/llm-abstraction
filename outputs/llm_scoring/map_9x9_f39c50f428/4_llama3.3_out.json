    "```python\ndef cluster_states(grid):\n    # Define the grid size\n    rows = len(grid)\n    cols = len(grid[0])\n\n    # Initialize a visited set to keep track of visited cells\n    visited = [[False for _ in range(cols)] for _ in range(rows)]\n\n    # Define the possible movements (up, down, left, right)\n    movements = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n    # Function to check if a cell is within the grid boundaries\n    def is_valid(x, y):\n        return 0 <= x < rows and 0 <= y < cols\n\n    # Perform DFS from each unvisited cell\n    clusters = []\n    for i in range(rows):\n        for j in range(cols):\n            if not visited[i][j] and grid[i][j] != 'X':\n                cluster = []\n                stack = [(i, j)]\n                visited[i][j] = True\n\n                while stack:\n                    x, y = stack.pop()\n                    cluster.append(grid[x][y])\n\n                    for dx, dy in movements:\n                        nx, ny = x + dx, y + dy\n                        if is_valid(nx, ny) and not visited[nx][ny] and grid[nx][ny] != 'X':\n                            stack.append((nx, ny))\n                            visited[nx][ny] = True\n\n                clusters.append(cluster)\n\n    return clusters\n\n\ngrid = [\n    [0, 2, 5, 9, 'X', 57, 49, 58, 62],\n    [1, 4, 8, 12, 'X', 50, 41, 51, 59],\n    [3, 7, 11, 14, 'X', 42, 36, 43, 52],\n    [6, 10, 13, 15, 17, 'X', 32, 'X', 56],\n    ['X', 'X', 'X', 16, 18, 'X', 27, 'X', 48],\n    [63, 60, 53, 'X', 19, 21, 24, 'X', 40],\n    [61, 54, 44, 'X', 20, 23, 26, 31, 35],\n    [55, 45, 37, 'X', 22, 'X', 30, 'X', 'X'],\n    [46, 38, 33, 28, 25, 29, 34, 39, 47]\n]\n\nprint(cluster_states(grid))\n```",
